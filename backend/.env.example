# Copy to .env and fill in.
# Local Postgres example:  postgres://USER:PASSWORD@localhost:5432/diamond_box
# Remote example:          postgres://USER:PASSWORD@HOST:5432/inventory_dev
#
# Point this at your DEVELOPMENT database — inventory_dev, never inventory.
# `npm test` TRUNCATES tables in whatever this names, so everything in it is
# disposable. The harness refuses outright if it names the production database.
DATABASE_URL=

# Optional. Only set this if the tests should use a different database from the
# one above; CI does, pointing it at a throwaway Postgres on the runner. Left
# empty, the tests use DATABASE_URL — one database to set up instead of two.
TEST_DATABASE_URL=

# Server
PORT=4000

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3000

# First owner account created by `npm run seed`
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9999999999
SEED_OWNER_PASSWORD=owner123
