# Copy to .env and fill in.
# Local Postgres example:  postgres://USER:PASSWORD@localhost:5432/diamond_box
# Neon (cloud) example:    postgres://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/diamond_box?sslmode=require
DATABASE_URL=

# Server
PORT=4000

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3000

# First owner account created by `npm run seed`
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9999999999
SEED_OWNER_PASSWORD=owner123
