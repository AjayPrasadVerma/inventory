# Copy to .env and fill in.
# Local Postgres example:  postgres://USER:PASSWORD@localhost:5432/diamond_box
# Remote example:          postgres://USER:PASSWORD@HOST:5432/inventory_dev
#
# Point this at your DEVELOPMENT database — inventory_dev, never inventory.
# `npm test` TRUNCATES tables in whatever this names, so everything in it is
# disposable. The harness refuses outright if it names the production database.
DATABASE_URL=

# Optional. Only set this if the tests should use a different database from the
# one above; CI does, pointing it at a throwaway Postgres on the runner. Left
# empty, the tests use DATABASE_URL — one database to set up instead of two.
TEST_DATABASE_URL=

# Server
PORT=4000

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# How long an access token lasts. JWT_EXPIRES_IN is the old name and still works;
# ACCESS_TOKEN_TTL is read first where both are set.
#
# Leave this at 7d for now. It SHOULD be 15m — that is the whole point of having
# refresh tokens — but the web frontend cannot refresh yet: it treats any 401 as
# the end of the session and returns to the login screen, so shortening this would
# sign the shop out every fifteen minutes. Short values are safe for a client that
# calls POST /api/auth/refresh, which is what the mobile app will do.
JWT_EXPIRES_IN=7d
# ACCESS_TOKEN_TTL=15m

# How long a refresh token lasts. Each refresh rotates and re-dates it, so this is
# the limit on being away from the app, not on staying signed in. Default 90.
REFRESH_TOKEN_TTL_DAYS=90

# Comma-separated origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3000

# First owner account created by `npm run seed`
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9999999999
SEED_OWNER_PASSWORD=owner123
